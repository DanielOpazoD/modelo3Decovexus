#!/bin/sh
# Antes de empujar, una comprobación proporcionada a lo que cambia frente a origin/main (decisión 347): `npm run feedback`
# mira formato y lint de esos archivos y los tipos; si sólo cambia documentación no corre pruebas, si cambia código corre
# las pruebas que lo importan, y si cambia configuración, herramientas, la interfaz o el renderer, toda la capa rápida.
# No acredita nada: lentas, matrices, cobertura, build y E2E las corre la CI, que es la puerta de fusión (docs/REGLAS.md).
set -e
# Git da una línea por referencia: «<ref local> <sha local> <ref remota> <sha remoto>». Un push que sólo borra ramas
# (todas las sha locales en ceros) no publica código: no hay nada que comprobar. Sin líneas, se comprueba como siempre.
hook_deletes_only=
while read -r hook_local_ref hook_local_sha hook_remote_ref hook_remote_sha; do
  case "$hook_local_sha" in
    '' | *[!0]*) hook_deletes_only=no ;;
    *) if [ -z "$hook_deletes_only" ]; then hook_deletes_only=yes; fi ;;
  esac
done
if [ "$hook_deletes_only" = yes ]; then
  echo 'El push sólo borra ramas remotas: no hay código que comprobar.'
  exit 0
fi
# Git exporta GIT_DIR, GIT_WORK_TREE e índice a los ganchos lanzados desde un worktree enlazado. Las pruebas que crean
# repositorios temporales no deben heredarlos: escribirían en el repositorio real. El gancho corre en la raíz de la copia
# de trabajo, así que Git la encuentra sin ellos; la preparación de vitest los retira también.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE
hook_head=$(git rev-parse HEAD)
hook_index=$(git write-tree)
hook_config=$(git hash-object "$(git rev-parse --git-common-dir)/config")
hook_start=$(date +%s)
# Acota la contención del pool: la mitad de las plazas disponibles, como máximo cuatro. No cambia plazos ni capas.
# Un límite explícito menor (p. ej. VITEST_MAX_WORKERS=3) se conserva.
VITEST_MAX_WORKERS=$(node -p 'const requested = Number(process.env.VITEST_MAX_WORKERS); Math.max(1, Math.min(4, Math.floor(require("node:os").availableParallelism() / 2), Number.isInteger(requested) && requested > 0 ? requested : 4))')
export VITEST_MAX_WORKERS
echo "Gancho: VITEST_MAX_WORKERS=$VITEST_MAX_WORKERS."
if git diff --quiet origin/main -- && [ -z "$(git ls-files --others --exclude-standard)" ]; then
  echo 'Sin cambios frente a origin/main: no hay nada que comprobar.'
  exit 0
fi
npm run feedback --silent
if [ "$(git rev-parse HEAD)" != "$hook_head" ] ||
  [ "$(git write-tree)" != "$hook_index" ] ||
  [ "$(git hash-object "$(git rev-parse --git-common-dir)/config")" != "$hook_config" ]; then
  echo 'El hook modificó HEAD, índice o configuración Git; publicación detenida.' >&2
  exit 1
fi
echo "Gancho de push: $(($(date +%s) - hook_start)) s."
